# Public address of the site (e.g. https://nutrix.app). Used in confirmation emails; leave empty locally.
NEXT_PUBLIC_SITE_URL=
# Local Supabase for Nutrix runs on 544xx so it can sit beside Gymix (543xx).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (Supabase dashboard > API keys; older projects call it service_role).
# Used to save Open Food Facts products into the shared library when someone picks one.
# Leave empty to switch the online lookup off.
SUPABASE_SECRET_KEY=
